# ─── Database ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=dental

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "require('crypto').randomBytes(64).toString('hex')"
JWT_SECRET=replace_this_with_a_long_random_secret

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
